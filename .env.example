# Copy to .env for local runs outside Docker. Every value below is the default,
# so an empty environment works as long as DATABASE_URL is set.

# ---- mode -------------------------------------------------------------------
# api | worker | all — selects which halves of the binary start.
APP_MODE=all
HTTP_ADDR=:8080
LOG_LEVEL=info
SERVICE_NAME=payload-service

# ---- database ---------------------------------------------------------------
# Required. The only setting with no default.
DATABASE_URL=postgres://payload:payload@localhost:5432/payload?sslmode=disable
DB_MAX_CONNS=20
MIGRATIONS_DIR=migrations
# Set to true to apply migrations and exit (used by the Kubernetes Job).
MIGRATE_ONLY=false

# ---- object storage ---------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
# Endpoint baked into presigned URLs; must be reachable by the processor.
S3_PRESIGN_ENDPOINT=http://localhost:9000
S3_PRESIGN_TTL=15m
S3_BUCKET=payloads
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_PATH_STYLE=true
# Bodies at or above the threshold use a multipart upload. S3 requires
# non-final parts to be at least 5 MiB, which startup validation enforces.
S3_MULTIPART_THRESHOLD=16777216
S3_PART_SIZE=8388608
S3_PART_CONCURRENCY=4

# ---- authentication ---------------------------------------------------------
# Comma-separated keys accepted on /api/v1 as `Authorization: Bearer <key>` or
# `X-API-Key: <key>`. Probes and /metrics stay open for kubelet and Prometheus.
# Empty disables authentication so the demo stack works out of the box; the
# server logs a warning when that is the case.
# API_KEYS=local-dev-key

# ---- ingest limits ----------------------------------------------------------
MAX_TEXT_BYTES=1048576
MAX_DOC_BYTES=20971520
MAX_IMAGE_BYTES=10485760
MAX_VIDEO_BYTES=209715200
# Bounds resident memory:
#   S3_PART_SIZE * (1 + 2*S3_PART_CONCURRENCY) * MAX_CONCURRENT_UPLOADS
#   = 8 MiB * 9 * 16 ≈ 1.1 GiB worst case.
# Requests beyond this are shed with 503 + Retry-After. The service logs the
# computed ceiling at startup — size the container limit against it.
MAX_CONCURRENT_UPLOADS=16

# ---- worker -----------------------------------------------------------------
# Defaults to the hostname (the pod name in Kubernetes); recorded as the
# owner of every claimed job.
# WORKER_ID=
WORKER_CONCURRENCY=4
# Jobs claimed per round trip. Defaults to WORKER_CONCURRENCY.
# WORKER_CLAIM_BATCH=4
WORKER_POLL_INTERVAL=1s
# Must comfortably exceed the longest job; the heartbeat renews at half of it.
WORKER_LEASE=2m
REAPER_INTERVAL=15s

# ---- retries ----------------------------------------------------------------
# Transient failures back off exponentially between base and max; permanent
# failures (4xx from the processor) are not retried at all.
MAX_ATTEMPTS=5
RETRY_BACKOFF_BASE=5s
RETRY_BACKOFF_MAX=10m

# ---- external processor -----------------------------------------------------
MOCK_PROCESSOR_URL=http://localhost:8090
MOCK_TIMEOUT=30s
# In-call retries; the job-level retry above is the durable one.
MOCK_MAX_RETRIES=3

# ---- observability ----------------------------------------------------------
# Empty disables the exporter; instrumentation still runs.
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4318
OTEL_EXPORTER_OTLP_INSECURE=true

# ---- lifecycle --------------------------------------------------------------
# Readiness fails first, then this delay lets the load balancer drop the pod
# before connections stop being accepted.
DRAIN_DELAY=3s
SHUTDOWN_TIMEOUT=25s

# ---- tests ------------------------------------------------------------------
# Integration and end-to-end tests skip themselves unless this is set.
# TEST_DATABASE_URL=postgres://test:test@localhost:55432/test?sslmode=disable
